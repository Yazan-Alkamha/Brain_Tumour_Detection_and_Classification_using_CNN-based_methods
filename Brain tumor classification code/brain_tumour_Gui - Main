# Importing necessary libraries
import tkinter as tk
from tkinter import filedialog
from PIL import Image, ImageTk
import numpy as np
import cv2
import tensorflow as tf
from tkinter import ttk

# Defining the mapping for tumour types
tumour_types = {0: 'Glioma', 1: 'Meningioma', 2: 'No-tumour', 3: 'Pituitary'}

# Function to preprocess the uploaded image for the model
def preprocess_image(image_path, image_size):
    img = cv2.imread(image_path)
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    img = cv2.resize(img, (image_size, image_size))
    img = img / 255.0
    img = np.expand_dims(img, axis=0)
    return img

# Function to classify the tumour and display the result
def classify_and_display(image_path, model, root, result_label, table):
    # Preprocess the image
    image = preprocess_image(image_path, image_size=224)

    # Make predictions
    probabilities = model.predict(image)
    predicted_class = np.argmax(probabilities)
    predicted_label = tumour_types[predicted_class]

    # Determine classification as positive or negative
    classification = 'Positive' if predicted_class in [0, 1, 3] else 'Negative'

    # Setting the colour of the result bar for visual effect red or green
    bar_color = 'red' if classification == 'Positive' else 'green'

     # Displaying the result bar
    bar_frame = tk.Frame(root, bg=bar_color, height=10)
    bar_frame.grid(row=2, column=0, columnspan=2, sticky='ew')

    # Displaying the uploaded image 
    img = Image.open(image_path)
    img = img.resize((500, 500))
    img = ImageTk.PhotoImage(img)
    image_label = tk.Label(root, image=img)
    image_label.image = img
    image_label.grid(row=3, column=0, columnspan=2)

    # Updating the result label for inaccurate results
    result_text = f'Tumour Type: {predicted_label}\nClassification: {classification}'
    result_label.config(text=result_text)

    # Updating the classification report in the table
    report = {
        "precision":  [0.99, 0.98, 0.97, 1.00],
        "recall":     [0.98, 0.95, 1.00, 1.00],
        "f1-score":   [0.99, 0.97, 0.99, 1.00],
        "support":    [149, 148, 198, 160]
    }

    # Clearing existing items in the table
    for item in table.get_children():
        table.delete(item)

    classes = ["Glioma", "Meningioma", "No-tumour", "Pituitary"]
    for i, cls in enumerate(classes):
        table.insert("", 'end', text=cls, values=(report['precision'][i], report['recall'][i], report['f1-score'][i], report['support'][i]))

    # Inserting the accuracy, macro avg, and weighted average in the table
    table.insert("", 'end', text="", values=("", "", "", "", ""))
    table.insert("", 'end', text="Accuracy", values=("", "", "0.98", "655", ""))
    table.insert("", 'end', text="Macro avg", values=("0.998", "0.98", "0.98", "655", ""))
    table.insert("", 'end', text="Weighted avg", values=("0.99", "0.98", "0.98", "655", ""))
    table.grid(row=5, column=0, columnspan=2, padx=10)

# Function to handle the image upload process 
def upload_image(root, result_label, table):
    file_path = filedialog.askopenfilename()
    if file_path:
        classify_and_display(file_path, model, root, result_label, table)

# Creating the application window
root = tk.Tk()
root.title("Brain Tumour Classification GUI")

# Loading the trained CNN model for classification
model_path = r"C:\Users\Mhd Alkamha\Desktop\GUI\cnn_model_98.h5"
